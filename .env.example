# Copy to .env.local. Values below are the standard LOCAL Supabase defaults
# (from `pnpm supabase:start`). For hosted Supabase, use your project's values.

# Postgres (Drizzle). Hosted: use the Supavisor pooled URL (transaction mode, port 6543).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Supabase API. VITE_ prefix ships to the browser; the server reads the same vars.
# Publishable key only. Never put secrets under VITE_.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# Secret for the daily scheduled-transactions cron job (hosted only). Generate a long random
# value, set it in Vercel env vars; Vercel sends it as `Authorization: Bearer <value>`.
# CRON_SECRET=
